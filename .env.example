# Copy to .env and fill in. The server refuses to start unless SESSION_SECRET,
# ADMIN_PASSWORD and ADMIN2_PASSWORD are set.

PORT=3011
DB_PATH=./data/chef.db

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=replace-with-a-long-random-string

# First owner account, created on first boot only.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Owner
ADMIN_PASSWORD=replace-with-a-strong-password

# Second account, created on first boot only.
ADMIN2_EMAIL=get@dimedata.cloud
ADMIN2_PASSWORD=replace-with-a-second-strong-password

# Optional: demo mode resets all data to the seed set every DEMO_RESET_MIN minutes.
DEMO_MODE=0
DEMO_RESET_MIN=20
